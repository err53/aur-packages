# Maintainer: Jason Huang <jasonhuang20035@gmail.com>
pkgname=podkit-bin
pkgver=0.6.0
pkgrel=1
pkgdesc='Modern sync toolkit and CLI for classic iPods'
arch=('x86_64' 'aarch64')
url='https://github.com/jvgomg/podkit'
license=('MIT')
depends=('ffmpeg')
provides=("podkit=$pkgver")
conflicts=('podkit')
options=('!strip')
source=("podkit-${pkgver}-LICENSE::https://raw.githubusercontent.com/jvgomg/podkit/podkit%40${pkgver}/LICENSE")
source_x86_64=("podkit-${pkgver}-linux-x64.tar.gz::https://github.com/jvgomg/podkit/releases/download/podkit%40${pkgver}/podkit-linux-x64.tar.gz")
source_aarch64=("podkit-${pkgver}-linux-arm64.tar.gz::https://github.com/jvgomg/podkit/releases/download/podkit%40${pkgver}/podkit-linux-arm64.tar.gz")
sha256sums=('2d417749dc9a62ba4c495f8f39c42707cacfb8b2de7697e91d7105abdf8b26f3')
sha256sums_x86_64=('b9424e8943df1e7aba08bf76b0bfcbcb9a3791be71963d082a5eb55f14d752ea')
sha256sums_aarch64=('f5fc404dece451c76b81d2582452f39371ed36e0462066329bf6ab06c93c7e1e')

check() {
  ./podkit --version | grep -F "$pkgver"
  ./podkit --help >/dev/null
}

package() {
  install -Dm755 podkit "$pkgdir/usr/bin/podkit"
  install -Dm644 "podkit-${pkgver}-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
